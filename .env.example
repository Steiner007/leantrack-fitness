# Copy to .env.local and fill in. These two values are safe for the browser
# (the anon key is protected by row-level security). NEVER put the
# service-role key in this file or anywhere in client code.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
